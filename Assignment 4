def demo(base: str) -> None:
    print("=" * 72)
    print("DEMONSTRATION: clean lines, duplicate, invalid e-mail, damaged line, "
          "missing file")
    print("=" * 72)
    in_dir = os.path.join(base, "input")
    out_dir = os.path.join(base, "output")
