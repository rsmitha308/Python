def build_large_file(path: str, n: int) -> None:
    rng = random.Random(1)
    with open(path, "w", encoding="utf-8") as handle:
        for i in range(n):
            regno = f"R{rng.randint(0, n * 3):08d}"           # some repeats
            handle.write(f"{regno}, student {i}, CSE, s{i}@college.edu, Dance; Quiz\n")


def timed(function, paths) -> float:
    start = time.perf_counter()
    function(paths, ErrorLog())
    return time.perf_counter() - start


def measure(base: str) -> None:
    print("\n" + "=" * 72)
    print("Measurement: set of seen regnos O(n) vs list search O(n^2)")
    print("=" * 72)
    print(f"{'n':>9} {'set (s)':>10} {'list search (s)':>17} {'ratio':>9}")
    print("-" * 49)
    set_times, list_times = {}, {}
    for n in (1_000, 5_000, 20_000):
        path = os.path.join(base, f"large_{n}.txt")
        build_large_file(path, n)
        set_times[n] = timed(process_files, [path])
        list_times[n] = timed(process_files_list_search, [path])
        print(f"{n:>9,} {set_times[n]:>10.4f} {list_times[n]:>17.4f} "
              f"{list_times[n] / set_times[n]:>8.1f}x")
    print(f"\nData growth 5,000 -> 20,000 = 4x")
    print(f"Set time growth             = {set_times[20_000] / set_times[5_000]:.1f}x  (about linear, O(n) average)")
    print(f"List-search time growth     = {list_times[20_000] / list_times[5_000]:.1f}x  (about 16x expected, O(n^2))")
    print("""
Analysis
    Time : set lookup is O(1) on average, so n registrations cost O(n).
           Searching a list of earlier registrations costs up to k comparisons
           for the k-th line, so n lines cost about n(n-1)/2 = O(n^2).
    Space: set approach stores the regnos once in the set and again in the
           clean-record list, so O(n) with a constant factor of about 2 for the keys.
           The list-search approach also uses O(n) (list of regnos), but wastes
           CPU rather than memory. The set trades a little extra memory for
           a large time saving.""")


