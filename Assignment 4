# ===========================================================================
# MODULE: errors.py
# ===========================================================================


class ValidationError(Exception):
    """Raised when a single line of input is unusable."""


class ErrorLog:
    """Collects error messages and writes them to a file at the end."""

    def __init__(self) -> None:
        self.entries: List[str] = []

    def add(self, source: str, line_no: int, reason: str, text: str = "") -> None:
        where = f"{source}" + (f":{line_no}" if line_no else "")
        shown = f" | {text.strip()}" if text.strip() else ""
        self.entries.append(f"[{where}] {reason}{shown}")

    def __len__(self) -> int:
        return len(self.entries)


# ===========================================================================
# MODULE: validator.py
# ===========================================================================

ALLOWED_LOCAL = set(string.ascii_letters + string.digits + "._%+-")
ALLOWED_DOMAIN = set(string.ascii_letters + string.digits + ".-")


def validate_email(email: str) -> bool:
    """Checks an e-mail address using string methods only."""
    if not email or " " in email or email.count("@") != 1:
        return False
    local, domain = email.split("@")
    if not local or not domain:
        return False
    if not set(local) <= ALLOWED_LOCAL or not set(domain) <= ALLOWED_DOMAIN:
        return False
    if "." not in domain or domain.startswith(".") or domain.endswith("."):
        return False
    if ".." in domain or domain.startswith("-"):
        return False
    return len(domain.rsplit(".", 1)[1]) >= 2        # top-level domain length


def parse_line(line: str) -> Dict[str, object]:
    """Splits one line into a record or raises ValidationError."""
    fields = [f.strip() for f in line.strip().split(",")]
    if len(fields) != 5:
        raise ValidationError(f"damaged line (expected 5 fields, got {len(fields)})")
    regno, name, department, email, events_raw = fields
    if not regno or not name or not department:
        raise ValidationError("damaged line (empty register number, name or department)")
    if not validate_email(email):
        raise ValidationError(f"invalid e-mail '{email}'")
    events = [e.strip().title() for e in events_raw.split(";") if e.strip()]
    if not events:
        raise ValidationError("no events chosen")
    return {
        "regno": regno.upper(),
        "name": name.title(),
        "department": department.upper(),
        "email": email.lower(),
        "events": sorted(set(events)),
    }


# ===========================================================================
# MODULE: reader.py
# ===========================================================================


def read_department_file(path: str, log: ErrorLog) -> Iterator[Tuple[int, str]]:
    """Yields (line number, text) pairs; logs and returns on file problems."""
    name = os.path.basename(path)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for number, text in enumerate(handle, start=1):
                if text.strip():                     # ignore blank lines
                    yield number, text
    except FileNotFoundError:
        log.add(name, 0, "department file is missing")
    except PermissionError:
        log.add(name, 0, "no permission to read file")
    except UnicodeDecodeError:
        log.add(name, 0, "file is not valid UTF-8 text (rest of file skipped)")
    except OSError as error:
        log.add(name, 0, f"could not read file: {error}")


# ===========================================================================
# MODULE: processor.py
# ===========================================================================


def process_files(paths: List[str], log: ErrorLog) -> List[Dict[str, object]]:
    """Reads all files; validates; removes duplicates using a set of regnos."""
    seen: Set[str] = set()
    clean: List[Dict[str, object]] = []
    for path in paths:
        name = os.path.basename(path)
        for number, text in read_department_file(path, log):
            try:
                record = parse_line(text)
            except ValidationError as error:
                log.add(name, number, str(error), text)
                continue
            if record["regno"] in seen:
                log.add(name, number, f"duplicate registration for {record['regno']} (first kept)", text)
                continue
            seen.add(record["regno"])
            clean.append(record)
    return clean


def process_files_list_search(paths: List[str], log: ErrorLog) -> List[Dict[str, object]]:
    """ALTERNATIVE: duplicates found by searching a list of earlier regnos: O(n^2)."""
    seen_list: List[str] = []
    clean: List[Dict[str, object]] = []
    for path in paths:
        name = os.path.basename(path)
        for number, text in read_department_file(path, log):
            try:
                record = parse_line(text)
            except ValidationError as error:
                log.add(name, number, str(error), text)
                continue
            if record["regno"] in seen_list:         # linear scan every time
                log.add(name, number, f"duplicate registration for {record['regno']}", text)
                continue
            seen_list.append(record["regno"])
            clean.append(record)
    return clean


