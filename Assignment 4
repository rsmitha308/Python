def safe_filename(event: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "_", event).strip("_").lower() or "event"


def write_master(records: List[Dict[str, object]], out_dir: str, log: ErrorLog) -> None:
    path = os.path.join(out_dir, "master.csv")
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write("regno,name,department,email,events\n")
            for r in sorted(records, key=lambda x: x["regno"]):
                handle.write(f"{r['regno']},{r['name']},{r['department']},"
                             f"{r['email']},{';'.join(r['events'])}\n")
    except OSError as error:
        log.add("master.csv", 0, f"could not write file: {error}")


def write_event_files(records: List[Dict[str, object]], out_dir: str,
                      log: ErrorLog) -> Dict[str, List[Dict[str, object]]]:
    by_event: Dict[str, List[Dict[str, object]]] = defaultdict(list)
    for r in records:
        for event in r["events"]:
            by_event[event].append(r)
    event_dir = os.path.join(out_dir, "events")
    try:
        os.makedirs(event_dir, exist_ok=True)
    except OSError as error:
        log.add("events/", 0, f"could not create folder: {error}")
        return by_event
    for event, people in by_event.items():
        path = os.path.join(event_dir, safe_filename(event) + ".txt")
        try:
            with open(path, "w", encoding="utf-8") as handle:
                handle.write(f"Participants for {event} ({len(people)})\n")
                handle.write("-" * 50 + "\n")
                for r in sorted(people, key=lambda x: x["regno"]):
                    handle.write(f"{r['regno']:<12}{r['name']:<22}{r['department']}\n")
        except OSError as error:
            log.add(os.path.basename(path), 0, f"could not write file: {error}")
    return by_event


def write_summary(records, by_event, lines_read: int, log: ErrorLog, out_dir: str) -> None:
    path = os.path.join(out_dir, "summary.txt")
    by_dept: Dict[str, int] = defaultdict(int)
    for r in records:
        by_dept[r["department"]] += 1
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write("COLLEGE FEST REGISTRATION SUMMARY\n")
            handle.write("=" * 40 + "\n")
            handle.write(f"Registration lines read : {lines_read}\n")
            handle.write(f"Valid unique students   : {len(records)}\n")
            handle.write(f"Problems logged         : {len(log)}\n\n")
            handle.write("Students per department\n")
            for dept in sorted(by_dept):
                handle.write(f"  {dept:<10}{by_dept[dept]}\n")
            handle.write("\nParticipants per event\n")
            for event in sorted(by_event):
                handle.write(f"  {event:<20}{len(by_event[event])}\n")
    except OSError as error:
        log.add("summary.txt", 0, f"could not write file: {error}")


def write_error_log(log: ErrorLog, out_dir: str) -> None:
    path = os.path.join(out_dir, "errors.log")
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write("\n".join(log.entries) + ("\n" if log.entries else ""))
    except OSError as error:
        print(f"Could not write error log: {error}", file=sys.stderr)


# ===========================================================================
# MODULE: main.py
# ===========================================================================


def count_lines(paths: List[str]) -> int:
    total = 0
    for path in paths:
        try:
            with open(path, "r", encoding="utf-8") as handle:
                total += sum(1 for line in handle if line.strip())
        except (OSError, UnicodeDecodeError):
            pass
    return total


def run(paths: List[str], out_dir: str) -> ErrorLog:
    log = ErrorLog()
    try:
        os.makedirs(out_dir, exist_ok=True)
    except OSError as error:
        print(f"Cannot create output folder: {error}", file=sys.stderr)
        return log
    records = process_files(paths, log)
    write_master(records, out_dir, log)
    by_event = write_event_files(records, out_dir, log)
    write_summary(records, by_event, count_lines(paths), log, out_dir)
    write_error_log(log, out_dir)
    return log


