def q7_validate():
    heading("Q7-E: Implement and validate (same inputs, same counts, same timing)")
    header = (f"{'n':>4} {'naive calls':>13} {'memo calls':>11} "
              f"{'naive ms':>11} {'memo ms':>9} {'loop ms':>9} {'same?':>6}")
    print(header)
    print("-" * len(header))
    for n in (5, 10, 20, 25, 30):
        start = time.perf_counter()
        naive_value, naive_calls = count_naive(n)
        naive_time = (time.perf_counter() - start) * 1000

        start = time.perf_counter()
        memo_value, memo_calls = count_memo(n)
        memo_time = (time.perf_counter() - start) * 1000

        start = time.perf_counter()
        loop_value = ways_iterative(n)
        loop_time = (time.perf_counter() - start) * 1000

        same = naive_value == memo_value == loop_value
        print(f"{n:>4} {naive_calls:>13,} {memo_calls:>11} "
              f"{naive_time:>11.4f} {memo_time:>9.4f} {loop_time:>9.4f} "
              f"{str(same):>6}")


def q7_defend():
    heading("Q7-F: Defend the final design")
    print("""\
Objective achieved : yes. Calls fell from exponential to n + 1 and every
                     result matched the original.
Size of improvement: at n = 30 the call count dropped by roughly 87,000x;
                     the gap widens with every extra step.
New costs          : memoised version stores n + 1 values and is still limited
                     by recursion depth; the loop version avoids both costs.
Where original may
still be preferable: for very small n (about 5 or less) the difference is
                     unmeasurable, and the plain recursion maps most directly
