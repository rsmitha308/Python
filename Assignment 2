# Q7: Diagnose, Redesign and Validate (chosen program: ways_naive)
# ---------------------------------------------------------------------------
def q7_diagnosis():
    heading("Q7-A: Diagnose the bottleneck (evidence from ways_naive)")
    tally = Counter()

    def traced(n):
        tally[n] += 1
        if n <= 1:
            return 1
        return traced(n - 1) + traced(n - 2)

    traced(20)
    total = sum(tally.values())
    distinct = len(tally)
    print(f"For n = 20: total calls = {total:,}, distinct sub-problems = {distinct}")
    print(f"Wasted (repeated) calls = {total - distinct:,} "
          f"({(total - distinct) / total:.2%} of all work)")
    print("Most repeated sub-problems:")
    for k, c in tally.most_common(5):
        print(f"  ways({k}) computed {c:,} times")
    print("\nDiagnosis: the same overlapping sub-problems are recomputed again "
          "and again;")
    print("the call count grows exponentially (~1.618^n) while only n + 1 "
          "distinct values exist.")


def q7_objective():
    heading("Q7-B: Design objective")
    print("Reduce calls/operations for n = 30 from about 2.7 million to at "
          "most n + 1 = 31,")
    print("so that runtime grows linearly in n, with identical results for "
          "every n tested.")


def q7_design():
    heading("Q7-C: Revised solution (pseudocode)")
    print("""\
Property exploited: overlapping sub-problems (ways(n) depends only on
ways(n-1) and ways(n-2), and each value is reused many times).

Pseudocode (bottom-up, constant extra memory):
    function ways_iterative(n):
        previous <- 1
        current  <- 1
        for i from 2 to n:
            previous, current <- current, previous + current
        return current

Pseudocode (memoised variant):
    function ways_memo(n):
        if n <= 1: return 1
        if n in cache: return cache[n]
        cache[n] <- ways_memo(n-1) + ways_memo(n-2)
        return cache[n]

Memory / trade-offs:
    memoised : O(n) extra memory, depth-limited by the recursion limit
    loop     : O(1) extra memory, no recursion limit, less 'readable' recurrence
""")


def q7_predict():
    heading("Q7-D: Prediction before implementing")
