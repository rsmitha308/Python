import sys
import threading
import time
from collections import Counter
from functools import lru_cache

# ---------------------------------------------------------------------------
# Call counter shared by the instrumented functions
# ---------------------------------------------------------------------------
calls = 0


# ---------------------------------------------------------------------------
# Three implementations
# ---------------------------------------------------------------------------
def ways_naive(n):
    """Ways to climb n temple steps taking 1 or 2 steps at a time (plain recursion)."""
    global calls
    calls += 1
    if n <= 1:
        return 1
    return ways_naive(n - 1) + ways_naive(n - 2)


@lru_cache(maxsize=None)
def ways_memo(n):
    """Same recurrence, but each distinct n is computed only once (memoisation)."""
    global calls
    calls += 1
    # TODO 1 (completed): same base case and recursive case as ways_naive
    if n <= 1:
        return 1
    return ways_memo(n - 1) + ways_memo(n - 2)


def ways_memo_dict(n, cache=None):
    """Memoisation with an explicit dictionary (alternative to lru_cache)."""
    if cache is None:
        cache = {}
    if n <= 1:
        return 1
    if n not in cache:
        cache[n] = ways_memo_dict(n - 1, cache) + ways_memo_dict(n - 2, cache)
    return cache[n]


def ways_iterative(n):
    """Bottom-up loop keeping only the last two values: O(n) time, O(1) space."""
    previous, current = 1, 1
    for _ in range(2, n + 1):
        previous, current = current, previous + current
    return current


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def count_naive(n):
    """Run ways_naive(n) and return (result, number_of_calls)."""
    global calls
    calls = 0
    result = ways_naive(n)
    return result, calls


def count_memo(n):
    """Run ways_memo(n) from a cold cache and return (result, number_of_calls)."""
    global calls
    ways_memo.cache_clear()
    calls = 0
    result = ways_memo(n)
    return result, calls


def heading(title):
    print("\n" + "=" * 72)
    print(title)
