# Q6 (d): growth investigation, n = 10, 20, 25, 30
# ---------------------------------------------------------------------------
def demo_growth():
    heading("Q6: Growth investigation (prediction vs measurement)")
    print("Prediction: naive calls = 2 * ways(n) - 1  (grows ~ 1.618^n)")
    print("            memo calls  = n + 1            (grows linearly)\n")
    header = (f"{'n':>4} {'naive calls':>13} {'predicted':>11} "
              f"{'memo calls':>11} {'predicted':>10} {'ratio':>10}")
    print(header)
    print("-" * len(header))
    for n in (10, 20, 25, 30):
        _, naive_calls = count_naive(n)
        _, memo_calls = count_memo(n)
        pred_naive = 2 * ways_iterative(n) - 1
        pred_memo = n + 1
        ratio = naive_calls / memo_calls
        print(f"{n:>4} {naive_calls:>13,} {pred_naive:>11,} "
              f"{memo_calls:>11} {pred_memo:>10} {ratio:>10,.0f}x")
    print("\nConclusion: measured counts match the prediction exactly. "
          "Each +1 in n multiplies naive calls by ~1.618 (the golden ratio).")


# ---------------------------------------------------------------------------
# Q6 (e): deployment decision, n = 1000 and the recursion limit
# ---------------------------------------------------------------------------
def demo_recursion_limit():
    heading("Q6: Deployment decision, ways_memo(1000) and sys.getrecursionlimit()")
    limit = sys.getrecursionlimit()
    print(f"Default recursion limit: {limit}")
    ways_memo.cache_clear()
    try:
        ways_memo(1000)
        print("ways_memo(1000) succeeded (the limit was not hit in this environment).")
    except RecursionError as error:
        print(f"RecursionError: {error}")
        print("Reason: from a cold cache, ways_memo(1000) recurses 1000 levels deep "
              "(1000 -> 999 -> ... -> 1)")
        print("        before any value is cached. Together with the frames already "
              "on the stack, the depth exceeds the limit.")

    # Option 1: raise the limit (run in a thread with a bigger C stack for safety).
    print("\nOption 1: raise the limit with sys.setrecursionlimit(5000)")
    holder = {}

    def worker():
        sys.setrecursionlimit(5000)
        ways_memo.cache_clear()
        holder["value"] = ways_memo(1000)

    try:
        threading.stack_size(64 * 1024 * 1024)
    except (ValueError, RuntimeError):
        pass
    thread = threading.Thread(target=worker)
    thread.start()
    thread.join()
    sys.setrecursionlimit(limit)
    if "value" in holder:
        digits = str(holder["value"])
        print(f"  ways(1000) = {digits[:20]}... ({len(digits)} digits)")
    else:
        print("  The raised limit still failed on this machine (C stack too small).")

    # Option 2: rewrite with a loop (no recursion at all).
    print("\nOption 2: rewrite with a loop (ways_iterative)")
    loop_value = ways_iterative(1000)
    print(f"  ways(1000) = {str(loop_value)[:20]}... ({len(str(loop_value))} digits)")
    if "value" in holder:
        print(f"  Both approaches agree: {holder['value'] == loop_value}")

    print("\nDecision: use the loop for deployment. Raising the limit only moves "
          "the ceiling and risks a")
    print("hard crash (stack overflow) if n is larger; the loop uses O(1) stack "
          "and O(1) extra memory.")
    print("Keep the memoised version for clarity where depth is known to be small.")


# ---------------------------------------------------------------------------
# Q6 (f): complexity analysis, all three versions for n = 1000
# ---------------------------------------------------------------------------
def demo_complexity():
    heading("Q6: Time and space analysis")
    print(f"{'Version':<18}{'Time':<10}{'Space':<28}")
    print(f"{'Plain recursion':<18}{'O(phi^n)':<10}{'O(n) call stack':<28}")
    print(f"{'Memoised':<18}{'O(n)':<10}{'O(n) cache + O(n) stack':<28}")
    print(f"{'Loop (2 values)':<18}{'O(n)':<10}{'O(1)':<28}")

    print("\nRunning all three for n = 1000:")
    start = time.perf_counter()
    loop_value = ways_iterative(1000)
    loop_time = time.perf_counter() - start

    holder = {}

    def worker():
        sys.setrecursionlimit(5000)
        ways_memo.cache_clear()
        start_memo = time.perf_counter()
        holder["value"] = ways_memo(1000)
        holder["time"] = time.perf_counter() - start_memo

    thread = threading.Thread(target=worker)
    thread.start()
    thread.join()
    sys.setrecursionlimit(1000)

    print(f"  Loop     : {loop_time * 1000:.4f} ms")
    if "value" in holder:
        print(f"  Memoised : {holder['time'] * 1000:.4f} ms "
              f"(matches loop: {holder['value'] == loop_value})")
    print("  Naive    : not run, it would need about 2 * ways(1000) calls, "
          "roughly 10^209. It would never finish.")


