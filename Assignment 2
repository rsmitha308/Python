# ---------------------------------------------------------------------------
# Q6 (a): call tree for n = 5
# ---------------------------------------------------------------------------
def print_call_tree(n, depth=0, counter=None):
    """Prints the recursion tree of the plain version and tallies repeated calls."""
    if counter is not None:
        counter[n] += 1
    print("    " * depth + f"ways({n})")
    if n <= 1:
        return
    print_call_tree(n - 1, depth + 1, counter)
    print_call_tree(n - 2, depth + 1, counter)


def demo_call_tree(n=5):
    heading(f"Q6: Call tree for ways_naive({n})")
    tally = Counter()
    print_call_tree(n, counter=tally)
    print(f"\nTotal calls for n = {n}: {sum(tally.values())}")
    print("Times each sub-problem was computed (the repetition):")
    for k in sorted(tally, reverse=True):
        note = "  <- repeated" if tally[k] > 1 else ""
        print(f"  ways({k}) computed {tally[k]} time(s){note}")


# ---------------------------------------------------------------------------
# Q6 (b): correctness check, n = 1..6
# ---------------------------------------------------------------------------
def demo_correctness():
    heading("Q6: Correctness check for n = 1 to 6 (hand-worked answers)")
    # Worked by hand: ways(1)=1 | ways(2)=1+1=2 | ways(3)=2+1=3
    #                 ways(4)=3+2=5 | ways(5)=5+3=8 | ways(6)=8+5=13
    expected = {1: 1, 2: 2, 3: 3, 4: 5, 5: 8, 6: 13}
    print(f"{'n':>3} {'hand':>6} {'naive':>7} {'memo':>7} {'loop':>7}  status")
    all_ok = True
    for n, hand in expected.items():
        naive = ways_naive(n)
        memo = ways_memo(n)
        loop = ways_iterative(n)
        ok = hand == naive == memo == loop
        all_ok &= ok
        print(f"{n:>3} {hand:>6} {naive:>7} {memo:>7} {loop:>7}  {'OK' if ok else 'MISMATCH'}")
    print("\nAll values verified." if all_ok else "\nVerification FAILED.")


