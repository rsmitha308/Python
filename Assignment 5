def diagnose(text):
    """Programmatic reason why a lexicon scorer can get a complaint wrong."""
    words = tokens(text)
    hits = [w for w in words if w in POSITIVE or w in NEGATIVE]
    if not hits:
        return "no lexicon word present (vocabulary gap: the meaning is expressed in other words)"
    if any(w in NEGATORS for w in words):
        return ("negation scope: only the single word right after a negator is flipped, "
                "so 'not a single clean ...' is read as positive")
    pos = [w for w in hits if w in POSITIVE]
    neg = [w for w in hits if w in NEGATIVE]
    if pos and neg:
        return "mixed positive and negative words cancel each other out"
    return "words are found but the meaning differs from the words (sarcasm / context)"


def agreement(scorer_label, data):
    same = sum(1 for text, mine in data if scorer_label(text) == mine)
    return same, len(data)


def study_agreement():
    heading("B4.1: Sentiment scorer vs my own reading (58 complaints)")
    assert len(COMPLAINTS) >= 50
    same, total = agreement(label, COMPLAINTS)
    same_rx, _ = agreement(label_regex, COMPLAINTS)
    print(f"Original scorer (given tokenising) : agree on {same} of {total} = {same / total:.1%}")
    print(f"Regex-tokenised scorer             : agree on {same_rx} of {total} = {same_rx / total:.1%}")

    print("\nPer-class agreement (original scorer):")
    for cls in ("positive", "negative", "neutral"):
        subset = [(t, m) for t, m in COMPLAINTS if m == cls]
        s, n = agreement(label, subset)
        print(f"  {cls:9} {s:>2} of {n:>2} = {s / n:.0%}")

    print("\nComplaints the scorer labels differently from me:")
    wrong = [(t, m, label(t)) for t, m in COMPLAINTS if label(t) != m]
    for text, mine, got in wrong[:12]:
        print(f"  mine={mine:8} scorer={got:8} | {text}")
        print(f"      why: {diagnose(text)}")
    if len(wrong) > 12:
        print(f"  ... and {len(wrong) - 12} more")

    reasons = Counter(diagnose(t).split(" (")[0].split(":")[0] for t, _, _ in wrong)
    print("\nCauses of disagreement (counted):")
    for reason, count in reasons.most_common():
        print(f"  {count:>2} x {reason}")
    return same / total


