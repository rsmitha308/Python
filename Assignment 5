def build_database(n_rows=300_000, n_stations=150, n_days=60, seed=7):
    pool = [(text, to_label(score_regex(text)), score_regex(text)) for text, _ in COMPLAINTS]
    rng = random.Random(seed)
    conn = sqlite3.connect(":memory:")
    conn.execute("""CREATE TABLE complaints (
                        id INTEGER PRIMARY KEY, station INTEGER, day INTEGER,
                        text TEXT, label TEXT, score INTEGER)""")

    def rows():
        for _ in range(n_rows):
            text, lab, sc = pool[rng.randrange(len(pool))]
            yield (rng.randrange(n_stations), rng.randrange(n_days), text, lab, sc)

    conn.executemany(
        "INSERT INTO complaints (station, day, text, label, score) VALUES (?,?,?,?,?)", rows())
    conn.commit()
    return conn


QUERIES = {
    "Q1 one station, one day": (
        "SELECT COUNT(*), AVG(score) FROM complaints WHERE station = ? AND day = ?",
        lambda r, ns, nd: (r.randrange(ns), r.randrange(nd))),
    "Q2 daily trend of one station": (
        "SELECT day, COUNT(*), AVG(score) FROM complaints WHERE station = ? "
        "GROUP BY day ORDER BY day",
        lambda r, ns, nd: (r.randrange(ns),)),
    "Q3 worst days of a station (week)": (
        "SELECT day, SUM(label = 'negative') AS neg FROM complaints "
        "WHERE station = ? AND day BETWEEN ? AND ? GROUP BY day ORDER BY neg DESC LIMIT 5",
        lambda r, ns, nd: (r.randrange(ns), (d := r.randrange(nd - 7)), d + 6)),
}


def time_queries(conn, n_stations, n_days, repeats=40):
    results = {}
    for name, (sql, make_params) in QUERIES.items():
        rng = random.Random(11)                      # same parameters before and after
        params = [make_params(rng, n_stations, n_days) for _ in range(repeats)]
        start = time.perf_counter()
        for p in params:
            conn.execute(sql, p).fetchall()
        results[name] = (time.perf_counter() - start) / repeats * 1000
    return results


def show_plan(conn, name):
    sql, make_params = QUERIES[name]
    params = make_params(random.Random(1), 150, 60)
    for row in conn.execute("EXPLAIN QUERY PLAN " + sql, params).fetchall():
        print("   plan:", row[3])


def study_database():
    heading("B4.2: Effect of an index on (station, day)")
    n_rows, n_stations, n_days = 300_000, 150, 60
    conn = build_database(n_rows, n_stations, n_days)
    print(f"Loaded {n_rows:,} complaints for {n_stations} stations over {n_days} days.\n")

    before = time_queries(conn, n_stations, n_days)
    slowest = max(before, key=before.get)
    print(f"Slowest query before the index: {slowest} ({before[slowest]:.3f} ms)")
    show_plan(conn, slowest)

    start = time.perf_counter()
    conn.execute("CREATE INDEX idx_station_day ON complaints (station, day)")
    conn.commit()
    build_time = (time.perf_counter() - start) * 1000
    print(f"\nIndex built in {build_time:.1f} ms.")
    after = time_queries(conn, n_stations, n_days)
    show_plan(conn, slowest)

    print(f"\n{'query':<36} {'before (ms)':>12} {'after (ms)':>12} {'speed-up':>10}")
    print("-" * 74)
    for name in QUERIES:
        print(f"{name:<36} {before[name]:>12.3f} {after[name]:>12.3f} "
              f"{before[name] / after[name]:>9.1f}x")
    gain = before[slowest] / after[slowest]
    print(f"\nSlowest query ({slowest}): {before[slowest]:.3f} ms -> "
          f"{after[slowest]:.3f} ms, {gain:.1f}x faster.")
    print("Without the index every query scans all rows (O(N)); with it, the "
          "database jumps to the matching (station, day) entries (O(log N + matches)).")
    conn.close()
    return gain


