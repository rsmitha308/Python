def _score_words(words):
    """+1 per positive word, -1 per negative word; a preceding negator flips it."""
    total = 0
    for i, word in enumerate(words):
        # TODO 1 (completed): value of each word, flipped if previous word is a negator
        value = 1 if word in POSITIVE else -1 if word in NEGATIVE else 0
        if value != 0 and i > 0 and words[i - 1] in NEGATORS:
            value = -value
        total += value
    return total


def score(text):
    """+1 per positive word, -1 per negative word; a preceding negator flips it."""
    words = text.lower().replace(".", " ").replace(",", " ").split()
    return _score_words(words)


def score_regex(text):
    """Same logic, but tokenises with a regex so '!', '?', ';' do not stick to words."""
    return _score_words(re.findall(r"[a-z']+", text.lower()))


def to_label(s):
    return "positive" if s > 0 else "negative" if s < 0 else "neutral"


def label(text):
    return to_label(score(text))


def label_regex(text):
    return to_label(score_regex(text))


