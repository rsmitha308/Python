# B4.3: cleaning, throughput and scale estimates
# ---------------------------------------------------------------------------
def clean_complaint(raw):
    """Ingestion cleaning: trim, collapse whitespace, reject empty/too short text."""
    if raw is None:
        return None
    text = re.sub(r"\s+", " ", str(raw)).strip()
    return text if len(text) >= 5 else None


def ingest(batch):
    """Cleans a batch and removes exact duplicates using a set (O(n) average)."""
    seen, clean, rejected, dupes = set(), [], 0, 0
    for raw in batch:
        text = clean_complaint(raw)
        if text is None:
            rejected += 1
        elif text.lower() in seen:
            dupes += 1
        else:
            seen.add(text.lower())
            clean.append(text)
    return clean, rejected, dupes


def study_scale(agree_rate):
    heading("B4.3: Production decision - evidence at the new scale")
    messy = ["  Bus   was slow. ", None, "ok", "Bus was slow.", "Platform is DIRTY.", ""]
    clean, rejected, dupes = ingest(messy)
    print(f"Cleaning demo: {len(messy)} raw -> {len(clean)} kept, "
          f"{rejected} rejected, {dupes} duplicate")

    texts = [t for t, _ in COMPLAINTS]
    batch = [texts[i % len(texts)] for i in range(50_000)]
    start = time.perf_counter()
    for t in batch:
        score_regex(t)
    scoring_time = time.perf_counter() - start
    rate = len(batch) / scoring_time
    print(f"\nScoring 50,000 complaints (one month): {scoring_time:.2f} s "
          f"({rate:,.0f} complaints/s)")

    avg_len = sum(len(t) for t in texts) / len(texts)
    row_bytes = avg_len + 48
    print(f"Complaint storage: about {row_bytes:.0f} bytes/row -> "
          f"{50_000 * row_bytes / 1e6:.1f} MB/month, {12 * 50_000 * row_bytes / 1e6:.0f} MB/year")
    readings = 100 * 96 * 30
    print(f"Station readings from 100 new stations: 100 x 96 per day = {100 * 96:,}/day "
          f"= {readings:,}/month")

    print(f"\nEvidence summary:")
    print(f"  * Scorer agreement with my reading: {agree_rate:.1%}")
    print(f"  * Speed is not a problem: one month of complaints scores in {scoring_time:.1f} s")
    print(f"  * Storage is small, so a single indexed SQL database is enough")

    threshold = 0.85
    print("\nDECISION")
    print("  Storage : keep raw complaints unchanged in an SQL table, and store the cleaned text,")
    print("            label and score in extra columns; add the (station, day) index;")
    print("            readings go in a separate table with the same index.")
    print("  Cleaning: clean at ingestion (trim, whitespace, empty-text rejection, duplicate")
    print("            removal with a set) and log rejected rows rather than stopping.")
    print("  Analysis: run scoring and summarising in a nightly batch, not per request.")
    if agree_rate >= threshold:
        print(f"  Method  : agreement {agree_rate:.1%} >= {threshold:.0%}, so the simple "
              "lexicon methods are good enough.")
    else:
        print(f"  Method  : agreement {agree_rate:.1%} is below the {threshold:.0%} target, so the "
              "lexicon is NOT good enough as the final judge.")
        print("            Use it only as a fast first-pass filter. Most errors come from words missing")
        print("            from the lexicon, negation scope and sarcasm, which a bigger word list")
        print("            fixes only partly. Label a few thousand complaints, train a classifier,")
        print("            and keep the lexicon score as a baseline to measure it against.")
    print("  Summary : use the frequency summariser for the dashboard; keep first-k only as a fallback")
    print("            for very long texts if time ever becomes a problem.")


