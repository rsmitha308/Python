def tokens(text):
    return re.findall(r"[a-z']+", text.lower())


def sentences_iter(text):
    """Lazily yields sentences, so a caller needing only the first k pays only for k."""
    for match in re.finditer(r"[^.!?]+[.!?]*", text):
        sentence = match.group().strip()
        if sentence:
            yield sentence


def content_words(text):
    return [w for w in tokens(text) if w not in STOPWORDS and len(w) > 2]


def summarise_frequency(text, k=1):
    """Keeps the k sentences holding the most frequent important words.
    Time O(words + s log s) for s sentences; space O(unique words)."""
    sents = list(sentences_iter(text))
    if len(sents) <= k:
        return " ".join(sents)
    freq = Counter(content_words(text))
    ranked = []
    for i, sentence in enumerate(sents):
        distinct = {w for w in content_words(sentence)}
        ranked.append((sum(freq[w] for w in distinct), -i, i))   # ties -> earlier
    best = sorted(ranked, reverse=True)[:k]
    return " ".join(sents[i] for i in sorted(idx for _, _, idx in best))


def summarise_first_k(text, k=1):
    """Alternative: the first k sentences. Time O(k) regardless of text length."""
    return " ".join(islice(sentences_iter(text), k))


def coverage(summary, text):
    """Share of the complaint's important-word weight captured by the summary
    (each distinct content word weighted by how often it occurs in the complaint)."""
    freq = Counter(content_words(text))
    total = sum(freq.values())
    if total == 0:
        return 1.0
    covered = sum(freq[w] for w in set(content_words(summary)))
    return covered / total


