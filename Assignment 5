def study_summarisers():
    heading("B4.1: Summariser quality on the 58 complaints (k = 1 sentence)")
    cov_f, cov_k, differ = [], [], 0
    for text, _ in COMPLAINTS:
        a, b = summarise_frequency(text), summarise_first_k(text)
        cov_f.append(coverage(a, text))
        cov_k.append(coverage(b, text))
        differ += (a != b)
    print(f"Mean important-word coverage, frequency method : {sum(cov_f) / len(cov_f):.3f}")
    print(f"Mean important-word coverage, first-k method   : {sum(cov_k) / len(cov_k):.3f}")
    print(f"Complaints where the two pick different sentences: {differ} of {len(COMPLAINTS)}")

    print("\nExamples (frequency method | first-k method):")
    shown = 0
    for text, _ in COMPLAINTS:
        a, b = summarise_frequency(text), summarise_first_k(text)
        if a != b and shown < 3:
            print(f"  full : {text}\n  freq : {a}\n  first: {b}\n")
            shown += 1

    heading("B4.1: Summariser time as the complaint grows (alternative-concept analysis)")
    rng = random.Random(3)
    subjects = ["bus", "platform", "toilet", "ticket counter", "lift", "waiting hall"]
    problems = ["is dirty", "was slow", "is broken", "was crowded", "smells bad"]

    def long_text(n_words):
        parts, count = [], 0
        while count < n_words:
            s = f"The {rng.choice(subjects)} {rng.choice(problems)} on day {rng.randint(1, 30)}."
            parts.append(s)
            count += len(s.split())
        return " ".join(parts)

    print(f"{'words':>9} {'frequency (ms)':>16} {'first-k (ms)':>14} {'ratio':>10}")
    print("-" * 53)
    for n in (100, 1_000, 10_000, 100_000):
        text = long_text(n)
        reps = 20 if n <= 10_000 else 3
        t0 = time.perf_counter()
        for _ in range(reps):
            summarise_frequency(text)
        t_freq = (time.perf_counter() - t0) / reps * 1000
        t0 = time.perf_counter()
        for _ in range(reps):
            summarise_first_k(text)
        t_first = (time.perf_counter() - t0) / reps * 1000
        print(f"{n:>9,} {t_freq:>16.4f} {t_first:>14.5f} {t_freq / max(t_first, 1e-9):>9,.0f}x")
    print("""
Time : frequency method reads every word, so it is O(words) (plus sorting the
       sentence scores). First-k stops after k sentences, so it is O(k), which
       is O(1) for a fixed k, however long the complaint is.
Space: frequency method keeps a counter of distinct important words and a score
       per sentence: O(unique words + sentences). First-k keeps only k
       sentences: O(k).
Trade-off: first-k is fastest but ignores content, so it can miss the
       main problem when it is stated late. The frequency method costs more
       time but selects the sentence most representative of the repeated topic.""")


